{
  "name": "recourse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:start": "node api/server.mjs",
    "buyer": "node scripts/buyer.mjs",
    "api:check": "node --check api/server.mjs",
    "test:api": "node --test tests/api/*.test.mjs",
    "setup:contracts": ".venv/bin/python scripts/contract-toolchain.py setup",
    "lint:contracts": ".venv/bin/python scripts/contract-toolchain.py check",
    "test": ".venv/bin/python scripts/contract-toolchain.py test tests/direct -q",
    "test:contracts": ".venv/bin/python scripts/contract-toolchain.py test tests/direct -v",
    "test:integration": ".venv/bin/python scripts/contract-toolchain.py test tests/integration -v",
    "typecheck": "npm --prefix web run typecheck",
    "build": "npm --prefix web run build",
    "lint": "npm run lint:contracts && npm --prefix web run lint",
    "verify": "npm run test:api && npm --prefix web test && npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build",
    "verify:acceptance": "npm run verify && npm --prefix web run test:browser",
    "deploy:studio-next": "node deploy/deploy.mjs",
    "verify:studio-next": "node deploy/verify.mjs",
    "preflight:release": "node scripts/release-preflight.mjs",
    "smoke:studio-dev": "node scripts/studio-dev-smoke.mjs",
    "demo:studio-next": "node scripts/studio-dev-demo.mjs",
    "smoke:buyer-flow": "node scripts/studio-next-buyer-flow.mjs",
    "register:agents": "node scripts/register-agents.mjs",
    "dev": "npm --prefix web run dev"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@privy-io/node": "^0.34.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.2.2",
    "genlayer-js": "2.0.0-rc.1",
    "ipaddr.js": "^2.2.0",
    "json-bigint": "^1.0.0",
    "undici": "^7.29.1",
    "viem": "^2.56.3"
  }
}
